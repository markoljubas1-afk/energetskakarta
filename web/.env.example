# Where the pipeline publishes data (R2 public URL or custom domain). Must end with a slash.
# Development default: /local-data/ served from ./.data (see README).
VITE_DATA_BASE_URL=/local-data/
# MapTiler key restricted to your domains. Without it the map uses the built-in fallback basemap.
VITE_MAPTILER_KEY=
# Public address of the site (no trailing slash): canonical links, sitemap, llms.txt. In CI it comes from
# the SITE_URL repository variable; leave it empty for local development.
VITE_SITE_URL=
